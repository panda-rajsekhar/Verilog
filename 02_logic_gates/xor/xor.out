#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x61d1d4f99130 .scope module, "tb_xor" "tb_xor" 2 10;
 .timescale 0 0;
v0x61d1d4fbef10_0 .var "A", 0 0;
v0x61d1d4fbefe0_0 .var "B", 0 0;
v0x61d1d4fbf0b0_0 .net "Y", 0 0, L_0x61d1d4fbf250;  1 drivers
v0x61d1d4fbf1b0_0 .var/i "i", 31 0;
S_0x61d1d4f734c0 .scope module, "uut" "xor_gate" 2 15, 2 1 0, S_0x61d1d4f99130;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /OUTPUT 1 "Y";
L_0x61d1d4fbf250 .functor XOR 1, v0x61d1d4fbef10_0, v0x61d1d4fbefe0_0, C4<0>, C4<0>;
v0x61d1d4f736f0_0 .net "A", 0 0, v0x61d1d4fbef10_0;  1 drivers
v0x61d1d4fbed30_0 .net "B", 0 0, v0x61d1d4fbefe0_0;  1 drivers
v0x61d1d4fbedf0_0 .net "Y", 0 0, L_0x61d1d4fbf250;  alias, 1 drivers
    .scope S_0x61d1d4f99130;
T_0 ;
    %vpi_call 2 21 "$dumpfile", "xor.vcd" {0 0 0};
    %vpi_call 2 22 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x61d1d4f99130 {0 0 0};
    %vpi_call 2 24 "$display", "Time\011A B |Y " {0 0 0};
    %vpi_call 2 25 "$display", "=================" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x61d1d4fbf1b0_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x61d1d4fbf1b0_0;
    %cmpi/s 4, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x61d1d4fbf1b0_0;
    %pad/s 2;
    %split/vec4 1;
    %store/vec4 v0x61d1d4fbefe0_0, 0, 1;
    %store/vec4 v0x61d1d4fbef10_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 30 "$display", "%0t\011%b %b | %b", $time, v0x61d1d4fbef10_0, v0x61d1d4fbefe0_0, v0x61d1d4fbf0b0_0 {0 0 0};
    %load/vec4 v0x61d1d4fbf1b0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x61d1d4fbf1b0_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %vpi_call 2 34 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "xor.v";
