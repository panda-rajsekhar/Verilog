#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5995f16ca4f0 .scope module, "tb_xnor_gate" "tb_xnor_gate" 2 8;
 .timescale 0 0;
v0x5995f16f02d0_0 .var "A", 0 0;
v0x5995f16f03a0_0 .var "B", 0 0;
v0x5995f16f0470_0 .net "Y", 0 0, L_0x5995f16f0750;  1 drivers
v0x5995f16f0570_0 .var/i "i", 31 0;
S_0x5995f16a44c0 .scope module, "uut" "xnor_gate" 2 13, 2 1 0, S_0x5995f16ca4f0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /OUTPUT 1 "Y";
L_0x5995f16f0610 .functor XOR 1, v0x5995f16f02d0_0, v0x5995f16f03a0_0, C4<0>, C4<0>;
L_0x5995f16f0750 .functor NOT 1, L_0x5995f16f0610, C4<0>, C4<0>, C4<0>;
v0x5995f16a46f0_0 .net "A", 0 0, v0x5995f16f02d0_0;  1 drivers
v0x5995f16f0010_0 .net "B", 0 0, v0x5995f16f03a0_0;  1 drivers
v0x5995f16f00d0_0 .net "Y", 0 0, L_0x5995f16f0750;  alias, 1 drivers
v0x5995f16f0170_0 .net *"_ivl_0", 0 0, L_0x5995f16f0610;  1 drivers
    .scope S_0x5995f16ca4f0;
T_0 ;
    %vpi_call 2 19 "$dumpfile", "xnor.vcd" {0 0 0};
    %vpi_call 2 20 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5995f16ca4f0 {0 0 0};
    %vpi_call 2 22 "$display", "Time\011A B |Y " {0 0 0};
    %vpi_call 2 23 "$display", "=================" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5995f16f0570_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x5995f16f0570_0;
    %cmpi/s 4, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x5995f16f0570_0;
    %pad/s 2;
    %split/vec4 1;
    %store/vec4 v0x5995f16f03a0_0, 0, 1;
    %store/vec4 v0x5995f16f02d0_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 28 "$display", "%0t\011%b %b | %b", $time, v0x5995f16f02d0_0, v0x5995f16f03a0_0, v0x5995f16f0470_0 {0 0 0};
    %load/vec4 v0x5995f16f0570_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5995f16f0570_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %vpi_call 2 32 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "xnor.v";
