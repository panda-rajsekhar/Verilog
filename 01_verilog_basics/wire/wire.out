#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x59f3d733d7a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x59f3d733d930 .scope module, "tb_single_wire" "tb_single_wire" 3 14;
 .timescale 0 0;
v0x59f3d734d570_0 .var "a", 0 0;
v0x59f3d734d610_0 .net "b", 0 0, L_0x59f3d734d6e0;  1 drivers
S_0x59f3d7304490 .scope module, "dut" "single_wire" 3 18, 3 3 0, S_0x59f3d733d930;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "b";
L_0x59f3d734d6e0 .functor BUFZ 1, v0x59f3d734d570_0, C4<0>, C4<0>, C4<0>;
v0x59f3d7304670_0 .net "a", 0 0, v0x59f3d734d570_0;  1 drivers
v0x59f3d734d450_0 .net "b", 0 0, L_0x59f3d734d6e0;  alias, 1 drivers
    .scope S_0x59f3d733d930;
T_0 ;
    %vpi_call/w 3 21 "$dumpfile", "wave.vcd" {0 0 0};
    %vpi_call/w 3 22 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x59f3d733d930 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59f3d734d570_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x59f3d734d570_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x59f3d734d570_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 27 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "wire.v";
