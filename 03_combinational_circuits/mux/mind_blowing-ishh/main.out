#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x56cff7845670 .scope module, "mux2048to1_tb" "mux2048to1_tb" 2 28;
 .timescale -9 -12;
v0x56cff786ff00_0 .var "data_in", 2047 0;
v0x56cff786fff0_0 .net "dout", 0 0, L_0x56cff7870420;  1 drivers
v0x56cff78700c0_0 .var/i "errors", 31 0;
v0x56cff7870190_0 .var "expected", 0 0;
v0x56cff7870230_0 .var/i "i", 31 0;
v0x56cff7870360_0 .var "sel", 10 0;
S_0x56cff7845800 .scope module, "DUT" "mux2048to1" 2 39, 2 7 0, S_0x56cff7845670;
 .timescale 0 0;
    .port_info 0 /INPUT 2048 "data_in";
    .port_info 1 /INPUT 11 "sel";
    .port_info 2 /OUTPUT 1 "dout";
v0x56cff7845a30_0 .net "data_in", 2047 0, v0x56cff786ff00_0;  1 drivers
v0x56cff786fd00_0 .net "dout", 0 0, L_0x56cff7870420;  alias, 1 drivers
v0x56cff786fdc0_0 .net "sel", 10 0, v0x56cff7870360_0;  1 drivers
L_0x56cff7870420 .part/v v0x56cff786ff00_0, v0x56cff7870360_0, 1;
    .scope S_0x56cff7845670;
T_0 ;
    %vpi_call 2 47 "$dumpfile", "mux2048to1_tb.vcd" {0 0 0};
    %vpi_call 2 48 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56cff7845670 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x56cff78700c0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x56cff7870230_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x56cff7870230_0;
    %cmpi/s 64, 0, 32;
    %jmp/0xz T_0.1, 5;
    %vpi_func 2 55 "$random" 32 {0 0 0};
    %load/vec4 v0x56cff7870230_0;
    %muli 32, 0, 32;
    %ix/vec4/s 4;
    %store/vec4 v0x56cff786ff00_0, 4, 32;
    %load/vec4 v0x56cff7870230_0;
    %addi 1, 0, 32;
    %store/vec4 v0x56cff7870230_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %vpi_call 2 58 "$display", "=================================================" {0 0 0};
    %vpi_call 2 59 "$display", " Starting exhaustive select sweep (0 to 2047)" {0 0 0};
    %vpi_call 2 60 "$display", "=================================================" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x56cff7870230_0, 0, 32;
T_0.2 ;
    %load/vec4 v0x56cff7870230_0;
    %cmpi/s 2048, 0, 32;
    %jmp/0xz T_0.3, 5;
    %load/vec4 v0x56cff7870230_0;
    %parti/s 11, 0, 2;
    %store/vec4 v0x56cff7870360_0, 0, 11;
    %delay 5000, 0;
    %load/vec4 v0x56cff786ff00_0;
    %load/vec4 v0x56cff7870230_0;
    %part/s 1;
    %store/vec4 v0x56cff7870190_0, 0, 1;
    %load/vec4 v0x56cff786fff0_0;
    %load/vec4 v0x56cff7870190_0;
    %cmp/ne;
    %jmp/0xz  T_0.4, 6;
    %load/vec4 v0x56cff78700c0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x56cff78700c0_0, 0, 32;
    %vpi_call 2 69 "$display", "MISMATCH at sel=%0d: dout=%b expected=%b", v0x56cff7870230_0, v0x56cff786fff0_0, v0x56cff7870190_0 {0 0 0};
T_0.4 ;
    %load/vec4 v0x56cff7870230_0;
    %addi 1, 0, 32;
    %store/vec4 v0x56cff7870230_0, 0, 32;
    %jmp T_0.2;
T_0.3 ;
    %vpi_call 2 74 "$display", "Exhaustive sweep complete. Errors so far: %0d", v0x56cff78700c0_0 {0 0 0};
    %vpi_call 2 77 "$display", "=================================================" {0 0 0};
    %vpi_call 2 78 "$display", " Running randomized trials" {0 0 0};
    %vpi_call 2 79 "$display", "=================================================" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x56cff7870230_0, 0, 32;
T_0.6 ;
    %load/vec4 v0x56cff7870230_0;
    %cmpi/s 20, 0, 32;
    %jmp/0xz T_0.7, 5;
    %vpi_func 2 81 "$random" 32 {0 0 0};
    %load/vec4 v0x56cff7870230_0;
    %muli 32, 0, 32;
    %ix/vec4/s 4;
    %store/vec4 v0x56cff786ff00_0, 4, 32;
    %vpi_func 2 82 "$random" 32 {0 0 0};
    %pushi/vec4 63, 0, 32;
    %load/vec4 v0x56cff7870230_0;
    %sub;
    %muli 32, 0, 32;
    %ix/vec4/s 4;
    %store/vec4 v0x56cff786ff00_0, 4, 32;
    %vpi_func 2 83 "$random" 32 {0 0 0};
    %pushi/vec4 2048, 0, 32;
    %mod/s;
    %pad/s 11;
    %store/vec4 v0x56cff7870360_0, 0, 11;
    %delay 5000, 0;
    %load/vec4 v0x56cff786ff00_0;
    %load/vec4 v0x56cff7870360_0;
    %part/u 1;
    %store/vec4 v0x56cff7870190_0, 0, 1;
    %load/vec4 v0x56cff786fff0_0;
    %load/vec4 v0x56cff7870190_0;
    %cmp/ne;
    %jmp/0xz  T_0.8, 6;
    %load/vec4 v0x56cff78700c0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x56cff78700c0_0, 0, 32;
    %vpi_call 2 88 "$display", "RANDOM TRIAL MISMATCH at sel=%0d: dout=%b expected=%b", v0x56cff7870360_0, v0x56cff786fff0_0, v0x56cff7870190_0 {0 0 0};
    %jmp T_0.9;
T_0.8 ;
    %vpi_call 2 91 "$display", "Trial %0d OK: sel=%0d dout=%b", v0x56cff7870230_0, v0x56cff7870360_0, v0x56cff786fff0_0 {0 0 0};
T_0.9 ;
    %load/vec4 v0x56cff7870230_0;
    %addi 1, 0, 32;
    %store/vec4 v0x56cff7870230_0, 0, 32;
    %jmp T_0.6;
T_0.7 ;
    %vpi_call 2 95 "$display", "=================================================" {0 0 0};
    %load/vec4 v0x56cff78700c0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_0.10, 4;
    %vpi_call 2 97 "$display", " ALL TESTS PASSED (2048-to-1 mux verified)" {0 0 0};
    %jmp T_0.11;
T_0.10 ;
    %vpi_call 2 99 "$display", " TESTS FAILED: %0d mismatches found", v0x56cff78700c0_0 {0 0 0};
T_0.11 ;
    %vpi_call 2 100 "$display", "=================================================" {0 0 0};
    %vpi_call 2 102 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "main.v";
