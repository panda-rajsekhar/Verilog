#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x570509d6a600 .scope module, "mux8to1_tb" "mux8to1_tb" 2 12;
 .timescale -12 -12;
v0x570509d7f380_0 .var "data_in", 7 0;
v0x570509d7f470_0 .net "dout", 0 0, L_0x570509d7f6e0;  1 drivers
v0x570509d7f540_0 .var/i "i", 31 0;
v0x570509d7f610_0 .var "sel", 2 0;
S_0x570509d6a790 .scope module, "uut" "mux8to1" 2 22, 2 1 0, S_0x570509d6a600;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "data_in";
    .port_info 1 /INPUT 3 "sel";
    .port_info 2 /OUTPUT 1 "dout";
v0x570509d6a9c0_0 .net "data_in", 7 0, v0x570509d7f380_0;  1 drivers
v0x570509d7f180_0 .net "dout", 0 0, L_0x570509d7f6e0;  alias, 1 drivers
v0x570509d7f240_0 .net "sel", 2 0, v0x570509d7f610_0;  1 drivers
L_0x570509d7f6e0 .part/v v0x570509d7f380_0, v0x570509d7f610_0, 1;
    .scope S_0x570509d6a600;
T_0 ;
    %vpi_call 2 30 "$dumpfile", "mux8to1.vcd" {0 0 0};
    %vpi_call 2 31 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x570509d6a600 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x570509d6a600;
T_1 ;
    %vpi_call 2 37 "$monitor", "Time = %0t | data_in = %b | sel = %b | dout = %b", $time, v0x570509d7f380_0, v0x570509d7f610_0, v0x570509d7f470_0 {0 0 0};
    %pushi/vec4 173, 0, 8;
    %store/vec4 v0x570509d7f380_0, 0, 8;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x570509d7f540_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x570509d7f540_0;
    %cmpi/s 8, 0, 32;
    %jmp/0xz T_1.1, 5;
    %load/vec4 v0x570509d7f540_0;
    %pad/s 3;
    %store/vec4 v0x570509d7f610_0, 0, 3;
    %delay 10, 0;
    %load/vec4 v0x570509d7f540_0;
    %addi 1, 0, 32;
    %store/vec4 v0x570509d7f540_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %pushi/vec4 83, 0, 8;
    %store/vec4 v0x570509d7f380_0, 0, 8;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x570509d7f540_0, 0, 32;
T_1.2 ;
    %load/vec4 v0x570509d7f540_0;
    %cmpi/s 8, 0, 32;
    %jmp/0xz T_1.3, 5;
    %load/vec4 v0x570509d7f540_0;
    %pad/s 3;
    %store/vec4 v0x570509d7f610_0, 0, 3;
    %delay 10, 0;
    %load/vec4 v0x570509d7f540_0;
    %addi 1, 0, 32;
    %store/vec4 v0x570509d7f540_0, 0, 32;
    %jmp T_1.2;
T_1.3 ;
    %vpi_call 2 58 "$display", "Simulation finished" {0 0 0};
    %vpi_call 2 59 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "8to1mux.v";
